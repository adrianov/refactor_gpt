# Copy to .env and set your credentials: cp .env.example .env

# Option A: z.ai GLM Coding Plan (https://z.ai/manage-apikey/apikey-list)
# API_KEY / BASE_URL are the suite's generic LLM knobs
# and work with any OpenAI-compatible endpoint.
#API_KEY=your-zai-key
#BASE_URL=https://api.z.ai/api/coding/paas/v4
#MODEL=glm-5.3

# Option B: OpenRouter (https://openrouter.ai/keys)
# Optional fallback connection: used for one retry when the primary fails
# unrecoverably (usage limit, exhausted balance, unauthorized key). MODEL_2 defaults to MODEL.
#API_KEY_2=sk-or-v1-your-fallback-key
#BASE_URL_2=https://openrouter.ai/api/v1
#MODEL_2=~openai/gpt-sol-latest

# Optional overrides (defaults shown)
#REQUEST_TIMEOUT=600

# Optional SOCKS proxy for all API calls (socks:// and socks5h:// become socks5://)
#PROXY_URL=socks5://127.0.0.1:1080
