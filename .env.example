# Copy to .env and set your credentials: cp .env.example .env

# Option A: z.ai GLM Coding Plan (https://z.ai/manage-apikey/apikey-list)
# OPENROUTER_API_KEY / OPENROUTER_BASE_URL are the suite's generic LLM knobs
# and work with any OpenAI-compatible endpoint.
#OPENROUTER_API_KEY=your-zai-key
#OPENROUTER_BASE_URL=https://api.z.ai/api/coding/paas/v4
#MODEL=glm-5.3

# Option B: OpenRouter (https://openrouter.ai/keys)
#OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional overrides (defaults shown)
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#MODEL=stealth/ox-alpha
#REQUEST_TIMEOUT=600

# Optional SOCKS proxy for all API calls (socks:// and socks5h:// become socks5://)
#PROXY_URL=socks5://127.0.0.1:1080
