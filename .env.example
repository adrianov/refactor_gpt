# Copy to .env and replace values
# Charles uses Claude by default when CLAUDE_ACCESS_TOKEN is set;
# then Gemini when GEMINI_ACCESS_TOKEN is set; otherwise OpenAI.

# Model names. Backend is chosen from the name (claude-* / gpt-* / gemini-*).
# Chat model: conversation replies. Technical: intent, topic, location, URL summary, emoji, etc.
MODEL=claude-sonnet-4-6
TECHNICAL_MODEL=claude-haiku-4-5
IMAGE_MODEL=gemini-2.0-flash-exp

# Claude (default when CLAUDE_ACCESS_TOKEN is set)
CLAUDE_BASE_URL=https://openrouter.ai/api/v1
CLAUDE_ACCESS_TOKEN=sk-...

# OpenAI (used when Claude and Gemini are not configured)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ACCESS_TOKEN=sk-...

# OpenRouter fallback (used automatically after retryable 429/5xx/network failures)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/auto

# Optional proxy for API requests (OpenAI, Gemini, OpenRouter, REFACTOR fallback)
# Prefers SOCKS5 when set. Also reads ALL_PROXY / HTTPS_PROXY / HTTP_PROXY.
# PROXY_URL=socks5://127.0.0.1:1080

# Gemini (used when Claude is not configured and GEMINI_ACCESS_TOKEN is set)
# Image generation: comma-separated list of models to try, first wins
GEMINI_BASE_URL=https://openrouter.ai/api/v1
GEMINI_ACCESS_TOKEN=sk-...
# IMAGE_MODEL above; for multiple image models: gemini-2.0-flash-exp,gemini-2.0-flash,gemini-2.0-flash-image

# Refactor-specific (refactor_gpt.rb)
REFACTOR_BASE_URL=https://api.anthropic.com/v1
REFACTOR_ACCESS_TOKEN=
REFACTOR_MODEL_1=claude-haiku-4-5
REFACTOR_MODEL_2=claude-sonnet-4-6
REFACTOR_MODEL_3=claude-opus-4-6

# Deployment
# DEPLOYMENT_SERVER=user@your-server.example.com
