# Copy to .env file and replace values
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ACCESS_TOKEN=sk-...
# PROXY_URL=socks5://127.0.0.1:1080
# DEFAULT_MODEL=glm-4.6

# Ask-specific settings for OpenAI (default)
# ASK_BASE_URL=https://api.openai.com/v1
# ASK_ACCESS_TOKEN=sk-...
# ASK_MODEL=glm-4.7

# Ask-specific settings for Gemini (use with --gemini flag)
GEMINI_BASE_URL=https://opencode.ai/zen/v1
GEMINI_ACCESS_TOKEN=sk-...
GEMINI_MODEL=gemini-3-flash

# Refactor-specific settings (takes precedence over OPENAI_BASE_URL)
REFACTOR_BASE_URL=https://api.anthropic.com/v1
REFACTOR_ACCESS_TOKEN=
REFACTOR_MODEL_1=claude-haiku-4-5
REFACTOR_MODEL_2=claude-sonnet-4-5
REFACTOR_MODEL_3=claude-opus-4-5
