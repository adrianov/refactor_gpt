# RefactorGPT Tools – Cursor rules

Project: Ruby CLI tools for refactoring (refactor_gpt.rb), code search (ag_gpt.rb), bash generation (bash_gpt.rb), Q&A (ask_gpt.rb), git commit (git_commit_gpt.rb), MR review (git_review_gpt.rb), merge conflict resolution (git_resolve_gpt.rb), superagent TUI (superagent.rb; subcommand ask = sandboxed one-shot Q&A, used for session continuation). Entry points use lib/loader (re-execs .ruby-version Ruby and drops a foreign Bundler env; Zeitwerk autoloading; lib/superagent, lib/superagent/prompt, lib/git_commit, lib/git_explain, lib/gemini, lib/primary_api collapsed). Shared code in lib/ (cli_paths, verify, cursor_rules/ (loader, project_source, user_source, program_source), agents_file_handler (facade: AGENTS.md, .cursorrules, project and user ~/.cursor/rules, REFACTOR.md, .env), ask_client_instructions, ask_gpt_client, ag_prompt, bash_prompt, conflict_resolve_prompt, completion_notifier, diff_compactor, diff_processor, instance_lock, llm_router, mr_review_client, mr_review_display, prompt_reader, refactor_assessment, lib/gemini/ (gemini_client, gemini_api_transport, gemini_content_stream, ask_gemini_client), lib/primary_api/ (openai_client, openrouter_client, openrouter_headers, openrouter_json, completion_answer, prompt_cache, api_error_display, error_response_body, primary_api_client, primary_api_http, primary_api_proxy, primary_api_ssl, primary_api_backoff/fallback/http_errors/progress, AccessDeniedError/BalanceError/RateLimitError/ServerError/NetworkResourceError), recent_shell_commands, refactor_gpt_utils, signal_handler, system_info, utility); git_commit in lib/git_commit/ (git_commit_session, git_commit_planner, git_commit_options [--debug/--watch/--auto 0-100 quiet output/--commit auto|yes|no default auto/--push/--file PATH/-- paths/hint], git_pathspec, git_status_paths, git_commit_numstat, git_commit_diff_capture, git_commit_diff_compaction, git_commit_display, git_commit_executor, git_commit_rubocop, git_per_path_unified_diff, commit_plan_client, commit_plan_response, commit_plan_finalize, commit_plan_instructions, commit_path_corrections); git_explain in lib/git_explain/ (git_explain_session, git_explainer); superagent in lib/superagent/ (agent_executor, assistant_text_accumulator, attempt_execution, auto_only_lock, config_path, display, json_stream_parser, long_build_detector, modified_files_tracker, outcome_display, pass_timing_builder, pass_timing_display, pending_request_queue, process_descendants, queue_display, refactor_needed_check, request_history_formatter, request_preparer, request_reader, run_failure_classifier, same_tool_error_tracker, session_id_registry, session_tracker, stream_line_parser, superagent, test_runner_detector, tool_call_formatter, tool_outcome, verification_display, verification_handler; prompt/ (agent_prompt_builder, agent_prompt_context, prompt_compactor)). Config: .env with MODEL, TECHNICAL_MODEL, IMAGE_MODEL, OPENROUTER_API_KEY, PROXY_URL (SOCKS5; process HTTP_PROXY ignored); backend from model name with OpenRouter fallback on BalanceError/rate-limit/5xx/network; PromptCache adds Anthropic/Qwen/Auto cache_control and prompt_cache_key on OpenRouter only; Auto also gets process-scoped session_id for sticky routing. Tests in test/ (agents_file_handler_test, classification_parsing_test, cli_paths_test, commit_plan_finalize_test, commit_plan_response_test, commit_path_corrections_test, git_commit_executor_test, git_commit_options_test, git_pathspec_test, git_status_paths_test, diff_compactor_helpers, diff_compactor_markers_test, diff_compactor_test, gemini_content_stream_test, llm_router_test, openrouter_client_test, primary_api_access_denied_test, primary_api_balance_error_test, primary_api_network_error_test, primary_api_proxy_test, primary_api_http_test, prompt_cache_test, system_prompt_stability_test, request_preparer_test, verification_parsing_test, tool_outcome_test, same_tool_error_tracker_test).
